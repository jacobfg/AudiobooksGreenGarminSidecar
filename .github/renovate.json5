{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "pip_requirements",
    "dockerfile",
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "separateMinorPatch": false,
  "packageRules": [
    {
      "description": "Treat FFmpeg image suffixes as build revisions, not compatibility variants",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mwader/static-ffmpeg"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:-(?<build>\\d+))?$"
    },
    {
      "description": "One application maintenance PR for minor and patch releases",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "application dependencies",
      "groupSlug": "application-dependencies"
    },
    {
      "description": "Leave pins, digests, replacements, and rollbacks for manual maintenance",
      "matchUpdateTypes": [
        "pin",
        "digest",
        "pinDigest",
        "replacement",
        "rollback",
        "bump"
      ],
      "enabled": false
    },
    {
      "description": "Show major upgrades in the dashboard and wait for approval",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(test|publish)\\.yml$/"
      ],
      "matchStrings": [
        "python-version: '(?<currentValue>\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "labels": [
    "dependencies",
    "bot"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "groupSingleUpdates": true,
  "ignoreUnstable": true,
  "logLevelRemap": [
    {
      "matchMessage": "/^Error updating branch$/",
      "newLogLevel": "error"
    }
  ]
}
